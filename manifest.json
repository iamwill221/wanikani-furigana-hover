{
  "manifest_version": 3,
  "name": "WaniKani Sentence Practice",
  "version": "1.0.0",
  "description": "Practice WaniKani sentences: hover for furigana, listen to the audio, and hide English translations until you click Show.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.wanikani.com/*", "https://preview.wanikani.com/*"],
      "js": ["vendor/kuromoji.js", "src/content.js"],
      "css": ["src/furigana.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dict/*.dat.gz"],
      "matches": ["https://www.wanikani.com/*", "https://preview.wanikani.com/*"]
    }
  ]
}
